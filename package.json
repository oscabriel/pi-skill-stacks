{
  "name": "pi-skill-stacks",
  "version": "0.5.1",
  "description": "Pi package that groups skills into named stacks you can manage from a /stacks overlay — toggle stacks on/off and re-stack skills without editing JSON. Exclusions are written through pi's own settings override mechanism.",
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "skills",
    "context",
    "skill-stacks"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oscabriel/pi-skill-stacks.git"
  },
  "files": [
    "extensions",
    "src",
    "README.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "check": "tsc -p tsconfig.json"
  }
}
